PORT=3000
# Keep this secret stable so access tokens survive restarts
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: encrypts shared text (AES-256-GCM) before it is stored in MongoDB.
# Use a long random string and keep it stable, or older text becomes unreadable.
TEXT_ENCRYPTION_KEY=

# MongoDB Atlas (share codes, file metadata, limits and counters)
# Atlas > Connect > Drivers. Put the database name in the URI (…mongodb.net/sendto?…).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/sendto?retryWrites=true&w=majority
# Optional: overrides the database name from the URI
MONGODB_DB_NAME=

# Google Drive (uploaded files). Create an OAuth client of type "Desktop app",
# then run `npm run google:auth` once to get the refresh token and folder id.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Private folder that holds the uploads (printed by `npm run google:auth`).
# If left empty, a private folder named GOOGLE_DRIVE_FOLDER_NAME is created for you.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_NAME=

# Limits
MAX_FILE_SIZE=104857600
# Total bytes of uploaded files kept at once. New uploads are refused past this.
MAX_TOTAL_STORAGE=10737418240
MAX_FILES=10
MAX_TEXT_LENGTH=500000
DEFAULT_EXPIRY_MINUTES=1440
MAX_EXPIRY_MINUTES=43200
